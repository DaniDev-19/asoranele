# Configuracion del Servidor
PORT=4000
NODE_ENV=development
SERVER_NAME="Asoranele Platform API"
APP_URL=http://localhost:4000

# Proveedor de Base de Datos: "local" | "neon" | "auto"
# - "local": usa DATABASE_URL
# - "neon": usa DATABASE_URL_NEON
# - "auto": usa DATABASE_URL_NEON en NODE_ENV=production y DATABASE_URL en development
DB_PROVIDER=local

# Base de Datos PostgreSQL Local
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# Base de Datos PostgreSQL Cloud (Neon)
DATABASE_URL_NEON="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Seguridad y CORS (separados por coma)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Almacenamiento de Imagenes: "r2" o "local"
STORAGE_DRIVER=local

# Credenciales de Cloudflare R2 (Requeridas si STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=https://cdn.tu-dominio.com
