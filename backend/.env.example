# Configuracion del Servidor
PORT=4000
NODE_ENV=development
SERVER_NAME="Asoranele Platform API"
APP_URL=http://localhost:4000

# Base de Datos PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public"

# Seguridad y CORS (separados por coma)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Almacenamiento de Imagenes: "r2" o "local"
STORAGE_DRIVER=local

# Credenciales de Cloudflare R2 (Requeridas si STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=https://cdn.tu-dominio.com
